input ProductInput {
    id: String
    name: String!,
    description: String,
    price: Float!,
    imgUrl: String!,
    categoryIdList: [ID]!
}

type Product {
    id: ID,
    name: String!,
    description: String,
    price: Float!,
    imgUrl: String!,
    status: String!,
    store: StoreDTO!,
    categories: [Category]!
}

input SearchingProductInput {
    searchingFor: String
    categoryIds: [ID]
    lng: Float!
    lat: Float!
    radius: Float
    paginatorInput: PaginatorInput!
}
